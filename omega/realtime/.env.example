# OMEGA Realtime Web Retrieval & Safety Pipeline Configuration
# ==============================================================

# Search API Configuration
# Option 1: Tavily Search API (Recommended - 1,000 free searches/month)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Option 2: Brave Search API (Optional alternative)
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here

# Option 3: SerpAPI Search Key (Optional alternative)
SERPAPI_API_KEY=your-serpapi-key-here

# Agriculture Market Data (Agmarknet via data.gov.in)
# Optional: If omitted, Mandi queries gracefully fall back to web_search
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key-here

# Financial & Stock Market Data
# Optional: Zero-key yfinance is enabled by default. Finnhub/AlphaVantage can be configured below.
FINNHUB_API_KEY=your-finnhub-api-key-here
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# Safety & Rate Limiting Settings
RATE_LIMIT_PER_USER_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=60
TAVILY_MONTHLY_BUDGET=1000
TAVILY_ALERT_THRESHOLD=800

# Cache TTL Configuration (in seconds)
CACHE_TTL_WEATHER=600
CACHE_TTL_PRICES=900
CACHE_TTL_FOREX=1800
CACHE_TTL_SEARCH=1800
CACHE_TTL_PAGE=7200
